# Copy to .env before running Docker Compose.
API_PORT=8000
QDRANT_PORT=6333
POSTGRES_PORT=5432
SEAWEEDFS_S3_PORT=8333
ENVIRONMENT=development
LOG_LEVEL=INFO

# Set this in shared or production-like environments. When set, callers must send
# it in the X-API-Key header. Leave blank for local development.
API_KEY=
CORS_ORIGINS=*

QDRANT_COLLECTION=rubric_chunks

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=seaweedfs
S3_SECRET_KEY=seaweedfs-secret
S3_REGION=us-east-1
S3_BUCKET=rubric-documents
S3_PRESIGNED_URL_EXPIRY_SECONDS=900

# OpenAI-compatible embeddings microservice. The default hostname works when a
# service named "embeddings" is attached to this Compose network.
EMBEDDINGS_URL=http://embeddings:8000/v1/embeddings
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_DIMENSION=384
EMBEDDINGS_API_KEY=
EMBEDDINGS_TIMEOUT_SECONDS=30
EMBEDDINGS_BATCH_SIZE=64
EMBEDDINGS_MAX_RETRIES=2

CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_SIZE_MB=25
